# Local defaults; copy to apps/api/.env if you need overrides.
# No secrets or external services are required for the health endpoint.
HOST=127.0.0.1
PORT=3001

# Optional three-process setup: npm run dev:instances configures these automatically.
# INSTANCE_ID=api-1
# INSTANCE_PEERS=http://127.0.0.1:3002,http://127.0.0.1:3003
# INSTANCE_SECRET=<shared 64-character hexadecimal secret; never commit a real value>

# Optional shared fixed-window state. Use the same Redis URL on every API instance.
# REDIS_URL=redis://127.0.0.1:6379
